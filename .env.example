# 复制为 .env 后按需修改；.env 不入库。
DATABASE_URL=postgres://mealmuse:mealmuse@localhost:5433/mealmuse
PORT=8787
LOG_LEVEL=info

# 加密存库的模型 API Key 用的主密钥。生成：openssl rand -base64 32
MODEL_SECRETS_KEY=

# 模型中转站（OpenAI 兼容）。填好后运行：pnpm --filter @mealmuse/server llm:import-env
# 导入后也可以在管理端「模型配置」中修改；Key 不要贴到聊天或提交到仓库。
LLM_PROVIDER_NAME=中转站
LLM_BASE_URL=https://jojocode.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-6.1-sol
# 中转站提供 Embedding 时填写，例如 text-embedding-3-small；没有就留空。
LLM_EMBEDDING_MODEL=
