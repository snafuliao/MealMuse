#!/usr/bin/env bash
# 提交规范（规则 §7.2）：Conventional Commits 前缀。由 `pnpm install` 的 prepare 脚本启用。
set -euo pipefail

subject="$(head -n1 "$1")"
pattern='^(feat|fix|chore|docs|refactor|test|build|ci|perf|style|revert)(\([a-z0-9-]+\))?!?: .+'

if [[ "$subject" =~ ^(Merge|Revert) ]] || [[ "$subject" =~ $pattern ]]; then
  exit 0
fi

cat >&2 <<MSG
✖ 提交信息不符合 Conventional Commits：
  $subject
修复：以类型前缀开头，例如
  feat(server): 新增每日推荐接口
  fix(ios): 修复健康检查超时
可用类型：feat fix chore docs refactor test build ci perf style revert
MSG
exit 1
