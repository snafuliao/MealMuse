{
  "name": "@mealmuse/server",
  "version": "0.1.0",
  "private": true,
  "description": "MealMuse 服务端：Agent 推荐与问答、菜谱数据、对外 OpenAPI。",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi": "tsx src/scripts/write-openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "admin:token": "tsx --env-file-if-exists=../../.env src/scripts/create-admin-token.ts",
    "llm:import-env": "tsx --env-file-if-exists=../../.env src/scripts/import-llm-env.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@hono/zod-openapi": "1.6.3",
    "@mealmuse/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
