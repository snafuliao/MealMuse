{
  "openapi": "3.1.0",
  "info": {
    "title": "MealMuse API",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "设备令牌（iOS）；管理端使用同一令牌的 HttpOnly Cookie"
      }
    },
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string"
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "enum": [
                  "ok",
                  "unreachable"
                ]
              }
            },
            "required": [
              "database"
            ]
          }
        },
        "required": [
          "status",
          "version",
          "checks"
        ]
      },
      "RedeemInviteResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/Me"
          }
        },
        "required": [
          "token",
          "user"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "displayName",
          "role"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "member",
          "admin"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "RedeemInviteRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "deviceName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "required": [
          "code",
          "displayName",
          "deviceName"
        ]
      },
      "AdminLoginRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "token"
        ]
      },
      "CreatedInvite": {
        "type": "object",
        "properties": {
          "invite": {
            "$ref": "#/components/schemas/Invite"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "invite",
          "code"
        ]
      },
      "Invite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "maxUses": {
            "type": "integer"
          },
          "usedCount": {
            "type": "integer"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "revokedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "role",
          "maxUses",
          "usedCount",
          "expiresAt",
          "revokedAt",
          "createdAt"
        ]
      },
      "CreateInviteRequest": {
        "type": "object",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "maxUses": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 1
          },
          "expiresInDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90,
            "default": 7
          }
        }
      },
      "UserSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastActiveAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Device"
            }
          }
        },
        "required": [
          "id",
          "displayName",
          "role",
          "createdAt",
          "lastActiveAt",
          "devices"
        ]
      },
      "Device": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ios",
              "admin_web"
            ]
          },
          "deviceName": {
            "type": "string"
          },
          "lastSeenAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "kind",
          "deviceName",
          "lastSeenAt",
          "createdAt"
        ]
      },
      "ModelProvider": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "baseUrl": {
            "type": "string",
            "format": "uri"
          },
          "chatModel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "embeddingModel": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 100
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 120000
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "apiKeyLast4": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "capabilities": {
            "$ref": "#/components/schemas/ProviderCapabilities"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "name",
          "baseUrl",
          "chatModel",
          "embeddingModel",
          "timeoutMs",
          "id",
          "apiKeyLast4",
          "isActive",
          "capabilities",
          "updatedAt"
        ]
      },
      "ProviderCapabilities": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "chat": {
            "type": "boolean"
          },
          "structuredOutput": {
            "type": "boolean"
          },
          "toolCalling": {
            "type": "boolean"
          },
          "embedding": {
            "type": "boolean"
          },
          "embeddingDimensions": {
            "type": [
              "integer",
              "null"
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "chat",
          "structuredOutput",
          "toolCalling",
          "embedding",
          "embeddingDimensions",
          "checkedAt",
          "errors"
        ]
      },
      "ModelProviderCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "baseUrl": {
            "type": "string",
            "format": "uri"
          },
          "chatModel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "embeddingModel": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 100,
            "default": null
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 120000,
            "default": 30000
          },
          "apiKey": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "name",
          "baseUrl",
          "chatModel",
          "apiKey"
        ]
      },
      "ModelProviderUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "baseUrl": {
            "type": "string",
            "format": "uri"
          },
          "chatModel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "embeddingModel": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 100
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 120000
          },
          "apiKey": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "LlmUsageRow": {
        "type": "object",
        "properties": {
          "purpose": {
            "$ref": "#/components/schemas/LlmPurpose"
          },
          "calls": {
            "type": "integer"
          },
          "failures": {
            "type": "integer"
          },
          "avgLatencyMs": {
            "type": "integer"
          },
          "inputTokens": {
            "type": "integer"
          },
          "outputTokens": {
            "type": "integer"
          }
        },
        "required": [
          "purpose",
          "calls",
          "failures",
          "avgLatencyMs",
          "inputTokens",
          "outputTokens"
        ]
      },
      "LlmPurpose": {
        "type": "string",
        "enum": [
          "recommend",
          "swap",
          "generate_recipe",
          "chat",
          "embedding",
          "structure_seed",
          "probe"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "system"
        ],
        "summary": "服务健康状态",
        "responses": {
          "200": {
            "description": "服务存活；数据库不可达时 status 为 degraded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/redeem": {
      "post": {
        "operationId": "redeemInvite",
        "tags": [
          "identity"
        ],
        "summary": "用邀请码注册，返回设备令牌（只返回一次）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedeemInviteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "注册成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedeemInviteResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "请求太频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getMe",
        "tags": [
          "identity"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "当前用户",
        "responses": {
          "200": {
            "description": "当前用户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "未登录或令牌无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/session": {
      "delete": {
        "operationId": "logout",
        "tags": [
          "identity"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "撤销当前设备令牌",
        "responses": {
          "204": {
            "description": "成功，无返回内容"
          },
          "401": {
            "description": "未登录或令牌无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/session": {
      "post": {
        "operationId": "adminLogin",
        "tags": [
          "admin"
        ],
        "summary": "管理端登录：校验管理员令牌并写入 HttpOnly Cookie",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "未登录或令牌无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "没有权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "请求太频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/invites": {
      "post": {
        "operationId": "createInvite",
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "生成邀请码（明文只返回一次）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInviteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已生成",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedInvite"
                }
              }
            }
          },
          "400": {
            "description": "请求不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未登录或令牌无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "没有权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listInvites",
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "邀请码列表（最近 100 条）",
        "responses": {
          "200": {
            "description": "邀请码列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Invite"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未登录或令牌无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "没有权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/invites/{id}/revoke": {
      "post": {
        "operationId": "revokeInvite",
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "撤销邀请码",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "已撤销",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invite"
                }
              }
            }
          },
          "401": {
            "description": "未登录或令牌无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "没有权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "资源不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "operationId": "listUsers",
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "用户与设备",
        "responses": {
          "200": {
            "description": "用户列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserSummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未登录或令牌无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "没有权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/devices/{id}/revoke": {
      "post": {
        "operationId": "revokeDevice",
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "撤销某台设备的令牌",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "成功，无返回内容"
          },
          "401": {
            "description": "未登录或令牌无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "没有权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "资源不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/model-providers": {
      "get": {
        "tags": [
          "admin",
          "model-config"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "operationId": "listModelProviders",
        "summary": "模型供应商列表（不含 API Key）",
        "responses": {
          "200": {
            "description": "供应商列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ModelProvider"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未登录或令牌无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "没有权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "admin",
          "model-config"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "operationId": "createModelProvider",
        "summary": "新增供应商",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModelProviderCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已创建",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelProvider"
                }
              }
            }
          },
          "400": {
            "description": "请求不合法",
            "content": {
              "application/json": {
                "schema": {
